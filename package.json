{
	"name": "@ersintarhan/pi-toolkit",
	"version": "0.10.1",
	"description": "Pi extension toolkit for Claude OAuth compatibility, native web search, and context management.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"pi-coding-agent",
		"claude-oauth",
		"anthropic",
		"web-search",
		"web-fetch",
		"search",
		"context-management"
	],
	"author": "Ersin Tarhan <ersintarhan@gmail.com>",
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint": "oxlint src/ extensions/ index.ts",
		"check": "bun run typecheck && bun run lint && bun test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ersintarhan/pi-toolkit.git"
	},
	"type": "module",
	"files": [
		"index.ts",
		"extensions",
		"src",
		"skills",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/status-display.ts",
			"./extensions/provider-usage.ts",
			"./extensions/context-report.ts",
			"./extensions/claude-oauth.ts",
			"./extensions/native-search.ts",
			"./extensions/context-management.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.84.3",
		"@earendil-works/pi-coding-agent": "^0.84.3",
		"@earendil-works/pi-tui": "^0.84.3",
		"@sinclair/typebox": "^0.34.52"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"oxlint": "^1.80.0",
		"typescript": "^7.0.2"
	}
}
